              { "key": "Authorization", "value": "Bearer {{user_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": "{{supabase_url}}/rest/v1/scores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{test_user_id}}\",\n  \"player_name\": \"User\",\n  \"score\": 5,\n  \"game\": \"pong\"\n}"
            }
