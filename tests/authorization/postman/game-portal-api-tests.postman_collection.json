    },
    {
      "name": "3. Admin - User Management",
      "item": [
        {
          "name": "3.1 List all users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('List users returns data', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.data.length).to.be.at.least(2);",
                  "  pm.expect(json.total).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Search users by name",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/users?search=User"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Search returns matching users', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.length).to.be.at.least(1);",
                  "  const names = json.data.map(u => u.display_name.toLowerCase());",
                  "  pm.expect(names.some(n => n.includes('user'))).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Ban test user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/users/{{test_user_id}}/ban",
            "body": {
              "mode": "raw",
              "raw": "{ \"is_banned\": true }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User banned successfully', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.is_banned).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Unban test user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/users/{{test_user_id}}/ban",
            "body": {
              "mode": "raw",
              "raw": "{ \"is_banned\": false }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User unbanned successfully', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.is_banned).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Change user role to admin",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/users/{{test_user_id}}/role",
            "body": {
              "mode": "raw",
              "raw": "{ \"role\": \"admin\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Role changed to admin', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.role).to.equal('admin');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Revert role to user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/users/{{test_user_id}}/role",
            "body": {
              "mode": "raw",
              "raw": "{ \"role\": \"user\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Role reverted to user', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.role).to.equal('user');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.7 Cannot ban self (409)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/users/{{admin_user_id}}/ban",
            "body": {
              "mode": "raw",
              "raw": "{ \"is_banned\": true }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cannot ban self returns 409', function() {",
                  "  pm.response.to.have.status(409);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error.code).to.equal('CONFLICT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.8 Cannot change own role (409)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/users/{{admin_user_id}}/role",
            "body": {
              "mode": "raw",
              "raw": "{ \"role\": \"user\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cannot change own role returns 409', function() {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Admin - Score Management",
      "item": [
        {
          "name": "4.1 Insert test score (via Supabase)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": "{{supabase_url}}/rest/v1/scores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{test_user_id}}\",\n  \"player_name\": \"User\",\n  \"score\": 200,\n  \"game\": \"snake\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Score inserted', function() {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('test_score_id', json[0].id);",
                  "  console.log('Score ID:', json[0].id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Insert second test score",
