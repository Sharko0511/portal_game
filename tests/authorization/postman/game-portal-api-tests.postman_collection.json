          ]
        },
        {
          "name": "4.3 List all scores (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/scores"
          },
          "event": [
            {
              "listen": "test",
              "script": {
