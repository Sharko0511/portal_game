          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('No token returns 401', function() {",
                  "  pm.response.to.have.status(401);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error.code).to.equal('UNAUTHORIZED');",
                  "});"
                ]
              }
            }
          ]
        },
