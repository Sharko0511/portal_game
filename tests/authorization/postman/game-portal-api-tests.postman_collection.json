{
  "info": {
    "name": "Game Portal API Tests",
    "description": "Full API test chain: Auth → User Actions → Admin endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth Flow",
      "item": [
        {
          "name": "1.1 Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login successful', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.access_token).to.be.a('string');",
                  "  pm.environment.set('admin_token', json.access_token);",
                  "  pm.environment.set('admin_user_id', json.user.id);",
                  "  console.log('Admin ID:', json.user.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login as User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User login successful', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.access_token).to.be.a('string');",
                  "  pm.environment.set('user_token', json.access_token);",
                  "  pm.environment.set('test_user_id', json.user.id);",
                  "  console.log('User ID:', json.user.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login with wrong password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"wrongpassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wrong password returns 400', function() {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Verify admin profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{supabase_url}}/rest/v1/profiles?id=eq.{{admin_user_id}}&select=*"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin profile exists with admin role', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array').with.lengthOf(1);",
                  "  pm.expect(json[0].role).to.equal('admin');",
                  "  pm.expect(json[0].display_name).to.equal('Admin');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Permission Tests (Negative)",
