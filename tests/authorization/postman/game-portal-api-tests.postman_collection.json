    {
      "name": "5. Admin - Game Config",
      "item": [
        {
          "name": "5.1 Get all game configs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/admin/games"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Game configs returned', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array').with.lengthOf(3);",
                  "  const ids = json.data.map(g => g.id);",
                  "  pm.expect(ids).to.include.members(['snake', 'pong', 'breakout']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Disable snake",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/games/snake",
            "body": {
              "mode": "raw",
              "raw": "{ \"enabled\": false }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Snake disabled', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.enabled).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.3 Verify snake hidden (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/games/config"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Snake not in public list', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  const ids = json.data.map(g => g.id);",
                  "  pm.expect(ids).to.not.include('snake');",
                  "  pm.expect(ids).to.include('pong');",
                  "  pm.expect(ids).to.include('breakout');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.4 Re-enable snake",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/admin/games/snake",
            "body": {
              "mode": "raw",
              "raw": "{ \"enabled\": true }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Snake re-enabled', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.enabled).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.5 Update snake speed config",
          "request": {
